# Production Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# ==================== DATABASE ====================
# Use a connection pooler URL for production
PGHOST='ep-floral-bonus-ahnsyf45-pooler.c-3.us-east-1.aws.neon.tech'
PGDATABASE='neondb'
PGUSER='neondb_owner'
PGPASSWORD='npg_87sauHxUcTnr'
PGSSLMODE='require'
PGCHANNELBINDING='require'
# Optional: Database pool settings
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=2000

# ==================== LIGHTNING (LNbits) ====================
# Use your PRODUCTION LNbits instance and wallet (do not use demo.lnbits.com)
LNBITS_URL=https://your-lnbits-instance.comhttps://your-lnbits-instance.com
LNBITS_API_KEY=your_invoice_read_key_from_production_wallet
LNBITS_ADMIN_KEY=your_admin_key_from_production_wallet
LNBITS_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32

# ==================== APPLICATION ====================s
NODE_ENV=production
PORT=4000

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://yourdomain.com

# Tournament buy-in amount in sats
BUY_IN_SATS=10000

# ==================== REDIS ====================
# Required for production (session/cache persistence)
REDIS_URL=redis://your-redis-host:6379

# ==================== SECURITY ====================
# Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_SECRET=generate_a_secure_random_string_here

# ==================== FRONTEND BUILD ====================
# API URL for frontend to connect to backend
VITE_API_URL=https://api.yourdomain.com

# ==================== OPTIONAL: MONITORING ====================
# Add your monitoring/logging service credentials here
# SENTRY_DSN=
# LOG_LEVEL=info

# ==================== CREDENTIAL ROTATION CHECKLIST ====================
# After initial deployment, rotate ALL of these credentials:
# [ ] DATABASE_URL password
# [ ] LNBITS_API_KEY
# [ ] LNBITS_ADMIN_KEY
# [ ] LNBITS_WEBHOOK_SECRET
# [ ] ADMIN_BOOTSTRAP_SECRET
